{
  "name": "@makvv4/oxlint-config",
  "version": "0.1.0",
  "description": "Native Oxlint presets for JavaScript, TypeScript, Vue, Nuxt and Node.js",
  "homepage": "https://github.com/makvv4/oxlint-config#readme",
  "bugs": {
    "url": "https://github.com/makvv4/oxlint-config/issues"
  },
  "license": "MIT",
  "author": "makvv4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makvv4/oxlint-config.git"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./formatter": {
      "types": "./dist/formatter.d.ts",
      "import": "./dist/formatter.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test scripts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "npm run build && node --test",
    "compare:antfu": "npm run build && node scripts/compare-antfu.mjs",
    "test:antfu-reference": "node scripts/check-antfu-reference.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  }
}
